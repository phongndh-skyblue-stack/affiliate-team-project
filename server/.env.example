APP_NAME=MIC ACE API
APP_ENV=development
DEBUG=true
APP_PORT=9030
API_PREFIX=/api
DATABASE_URL=sqlite:///./micace.db
SQLALCHEMY_ECHO=false
JWT_ALGORITHM=HS256
JWT_SECRET_KEY=change-me-access-secret
JWT_REFRESH_SECRET_KEY=change-me-refresh-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Third-party API keys — dùng dấu phẩy để thêm nhiều key (xoay vòng khi hết quota)
SERPAPI_KEYS=your-serpapi-key-1,your-serpapi-key-2
TAVILY_KEYS=tvly-your-tavily-key-1,tvly-your-tavily-key-2

# Redis / ARQ background jobs
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
ARQ_REDIS_URL=redis://127.0.0.1:6379/0
ARQ_QUEUE_NAME=arq:queue

# SimilarWeb cookie cache in Redis
SIMILARWEB_COOKIE_CACHE_TTL_SECONDS=21600
SIMILARWEB_COOKIE_REFRESH_LOCK_TTL_SECONDS=600

# Proxy encryption
# Generate once: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PROXY_ENCRYPTION_KEY=
PROXY_ENCRYPTION_KEY_FALLBACKS=

# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_VERIFICATION_TTL_SECONDS=600
